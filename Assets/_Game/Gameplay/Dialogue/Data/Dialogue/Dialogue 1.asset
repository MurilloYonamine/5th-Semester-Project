MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ac894d0daeb88048bc639e71956b0c5, type: 3}
  m_Name: Dialogue 1
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: 'Ellie! Bom dia!! '
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "Os pacientes est\xE3o esperando por voc\xEA para entregar os das doses
      di\xE1rias,"
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "elas est\xE3o em cima da mesa."
  - speaker: {fileID: 11400000, guid: 47acda34cf2651e4f9375ce0faa3198e, type: 2}
    text: "Alguma intercorr\xEAncia semana passada?"
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "2 pacientes recusaram a medica\xE7\xE3o, os mesmo."
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: Um deles reconsiderou e demos uma dose pesada para ele.
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "A\xED tivemos choro no quarto 4,mas foi acalmado."
  - speaker: {fileID: 11400000, guid: 47acda34cf2651e4f9375ce0faa3198e, type: 2}
    text: O outro?
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "Ser\xE1 considerado em breve."
  aftertalkingLines:
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "V\xE1 entregar as doses di\xE1rias Ellie."
  - speaker: {fileID: 11400000, guid: 7987eaa882d693f4c9a415cb98aca650, type: 2}
    text: "Elas est\xE3o em cima da mesa."
